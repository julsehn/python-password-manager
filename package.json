{
  "name": "sherlock",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node node_modules/.bin/vite --configLoader runner",
    "build": "node node_modules/.bin/vite build --configLoader runner",
    "format:check": "prettier --check \"src-web/**/*.{js,css,html}\" \"browser-extension/**/*.{js,css,html,json}\" index.html package.json vite.config.js eslint.config.js",
    "lint": "eslint .",
    "preview": "node node_modules/.bin/vite preview --configLoader runner",
    "test": "node --test src-web/*.test.js browser-extension/*.test.js",
    "tauri": "DEVELOPER_DIR=\"/Applications/Xcode.app/Contents/Developer\" PATH=\"/Applications/Xcode.app/Contents/Developer/usr/bin:$HOME/.cargo/bin:$HOME/.rustup/toolchains/stable-aarch64-apple-darwin/bin:$PATH\" tauri",
    "icons:compile": "sh tools/compile_icons.sh",
    "build:app": "npm run tauri -- build --bundles app && rm -rf ../SherLock.app && cp -R src-tauri/target/release/bundle/macos/SherLock.app ../SherLock.app",
    "tauri:build:macos:release": "sh tools/build_macos_release.sh"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.5",
    "dompurify": "^3.4.18",
    "lucide": "^0.468.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.12.5",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "vite": "^7.3.8"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  }
}
