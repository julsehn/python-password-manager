{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SherLock",
  "version": "0.1.0",
  "identifier": "com.juls.sherlock",
  "build": {
    "beforeDevCommand": "node node_modules/.bin/vite --configLoader runner",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "node node_modules/.bin/vite build --configLoader runner",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SherLock",
        "width": 1120,
        "height": 760,
        "minWidth": 880,
        "minHeight": 620,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "windowEffects": {
          "effects": [
            "sidebar",
            "mica"
          ],
          "state": "active",
          "radius": 14
        }
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' https://fonts.googleapis.com; style-src-attr 'none'; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data:; connect-src 'self' ipc: http://ipc.local https://password-manager-cloud-production.up.railway.app; object-src 'none'; base-uri 'self'; form-action 'self'"
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "targets": "all",
    "macOS": {
      "minimumSystemVersion": "11.0",
      "hardenedRuntime": true,
      "infoPlist": "icons/Info.plist",
      "files": {
        "Resources/Assets.car": "icons/Assets.car"
      }
    },
    "windows": {
      "wix": {
        "language": "en-US"
      }
    }
  }
}
