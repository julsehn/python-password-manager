{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Caixa forta",
  "version": "0.1.0",
  "identifier": "com.juls.caixaforta",
  "build": {
    "beforeDevCommand": "node node_modules/.bin/vite --configLoader runner",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "node node_modules/.bin/vite build --configLoader runner",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Caixa forta",
        "width": 1120,
        "height": 760,
        "minWidth": 880,
        "minHeight": 620,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "windowEffects": {
          "effects": ["sidebar", "mica"],
          "state": "active",
          "radius": 14
        }
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' https://fonts.googleapis.com; style-src-attr 'none'; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data:; connect-src 'self' ipc: http://ipc.local; object-src 'none'; base-uri 'self'; form-action 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "macOS": {
      "minimumSystemVersion": "11.0",
      "hardenedRuntime": true
    },
    "windows": {
      "wix": {
        "language": "en-US"
      }
    }
  }
}
